            ],
            "url": {
              "raw": "{{baseUrl}}/tasks?page=1&limit=10&status=todo&priority=high",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "todo" },
                { "key": "priority", "value": "high" }
