            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Configure Terraform Scripts\",\n  \"description\": \"Write Terraform HCL configs for VPC and RDS clusters\",\n  \"status\": \"todo\",\n  \"priority\": \"high\",\n  \"projectId\": {{projectId}},\n  \"dueDate\": \"2026-11-01T12:00:00.000Z\"\n}"
